# 02-powers-rbw-float.patch
#
# Fix `powers` reading the spectrum response's RESOLUTION_BW as a double.
# radiod ENCODES it as a 4-byte float (radio_status.c), but powers'
# extract_powers decoded it with decode_double -> misread (~0), so the
# header's bin width (and the derived start/stop freqs) collapsed to
# 0 / center-only, even though the bins were correctly spaced (radiod
# decodes the *command's* RESOLUTION_BW with decode_float). Receive-side
# mirror of 01: decode_double -> decode_float.
#
# Candidate upstream PR. Applies against KA9Q_RADIO_SHA 6a5094ac; still
# present on main (line numbers differ).
diff --git a/src/powers.c b/src/powers.c
index 67c3bc3c..72127301 100644
--- a/src/powers.c
+++ b/src/powers.c
@@ -352,7 +352,7 @@ int extract_powers(float *power,int npower,uint64_t *time,double *freq,double *r
       }
       break;
     case RESOLUTION_BW:
-      *rbw = decode_double(cp,optlen);
+      *rbw = decode_float(cp,optlen);
       break;
     case BIN_COUNT: // Do we check that this equals the length of the BIN_DATA tlv?
       l_ccount = decode_int(cp,optlen);
